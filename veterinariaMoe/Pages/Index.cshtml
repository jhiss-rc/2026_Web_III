@page
@model IndexModel
@{
    ViewData["Title"] = "Inicio";
}

<!-- Seccion principal -->
<section class="seccion-principal">
    <div class="container">
        <h1 class="titulo-principal">🐾 Arca de Moe</h1>
        <p class="subtitulo-principal">Veterinaria &amp; Centro de Gestión Animal</p>
        <p class="descripcion-principal">
            Cuidamos la salud y el bienestar de tus mascotas con profesionalismo y cariño.
            Agenda tu cita fácilmente y lleva el control completo de la salud de tu compañero.
        </p>
    </div>
</section>

<!-- Barra de estadisticas -->
<section class="barra-estadisticas">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-6 col-md-3 elemento-estadistica">
                <span class="numero-estadistica">+500</span>
                <span class="etiqueta-estadistica">Mascotas Atendidas</span>
            </div>
            <div class="col-6 col-md-3 elemento-estadistica">
                <span class="numero-estadistica">8</span>
                <span class="etiqueta-estadistica">Veterinarios</span>
            </div>
            <div class="col-6 col-md-3 elemento-estadistica">
                <span class="numero-estadistica">+300</span>
                <span class="etiqueta-estadistica">Propietarios</span>
            </div>
            <div class="col-6 col-md-3 elemento-estadistica">
                <span class="numero-estadistica">5</span>
                <span class="etiqueta-estadistica">Años de Experiencia</span>
            </div>
        </div>
    </div>
</section>

<!-- Servicios -->
<section class="seccion-servicios" id="servicios">
    <div class="container">
        <div class="text-center mb-2">
            <h2 class="titulo-seccion">Nuestros Servicios</h2>
            <p class="subtitulo-seccion">Todo lo que tu mascota necesita en un solo lugar</p>
        </div>
        <div class="row g-4">
            <div class="col-sm-6 col-lg-3">
                <div class="tarjeta-servicio">
                    <span class="icono-servicio">🩺</span>
                    <h5>Consulta General</h5>
                    <p>Revisiones de rutina y diagnósticos para mantener a tu mascota en óptimas condiciones.</p>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="tarjeta-servicio">
                    <span class="icono-servicio">💉</span>
                    <h5>Vacunación</h5>
                    <p>Programa completo de vacunación para proteger a tu compañero contra enfermedades.</p>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="tarjeta-servicio">
                    <span class="icono-servicio">🔬</span>
                    <h5>Laboratorio</h5>
                    <p>Análisis clínicos y estudios de diagnóstico con equipos de última tecnología.</p>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="tarjeta-servicio">
                    <span class="icono-servicio">📋</span>
                    <h5>Historial Clínico</h5>
                    <p>Registro detallado de consultas, diagnósticos y tratamientos de cada mascota.</p>
                </div>
            </div>
        </div>
    </div>
</section>
