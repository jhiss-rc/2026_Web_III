@page
@model veterinariaMoe.Pages.CitasModel
@{
    ViewData["Title"] = "Gestión de Citas";
}

<div class="encabezado-pagina">
    <div class="container">
        <h1 class="titulo-pagina">Gestión de Citas</h1>
    </div>
</div>

<div class="container seccion-contenido">
    <div class="row g-4">

        <div class="col-md-4">
            <div class="registro-contenedor">
                <h5 class="titulo-panel">Nueva Cita</h5>
                <form method="post" asp-antiforgery="false">
                    @Html.AntiForgeryToken()
                    <div class="campo">
                        <label>Mascota</label>
                        <select asp-for="Cita.MascotaId">
                            <option value="">Selecciona una mascota</option>
                            @foreach (var m in Model.ListaMascotas)
                            {
                                <option value="@m.Id">@m.Nombre (@m.Especie)</option>
                            }
                        </select>
                        <span asp-validation-for="Cita.MascotaId" class="texto-error"></span>
                    </div>
                    <div class="campo">
                        <label>Veterinario</label>
                        <select asp-for="Cita.VeterinarioId">
                            <option value="">Selecciona un veterinario</option>
                            @foreach (var v in Model.ListaVeterinarios)
                            {
                                <option value="@v.Id">@v.Nombre @v.Apellidos</option>
                            }
                        </select>
                        <span asp-validation-for="Cita.VeterinarioId" class="texto-error"></span>
                    </div>
                    <div class="campo">
                        <label>Fecha</label>
                        <input asp-for="Cita.Fecha" type="date" />
                        <span asp-validation-for="Cita.Fecha" class="texto-error"></span>
                    </div>
                    <div class="campo">
                        <label>Hora</label>
                        <input asp-for="Cita.Hora" type="time" />
                        <span asp-validation-for="Cita.Hora" class="texto-error"></span>
                    </div>
                    <div class="campo">
                        <label>Motivo</label>
                        <input asp-for="Cita.Motivo" placeholder="Ej: Revisión general" />
                        <span asp-validation-for="Cita.Motivo" class="texto-error"></span>
                    </div>
                    <div class="campo">
                        <label>Estado</label>
                        <select asp-for="Cita.EstadoCita">
                            <option value="">Selecciona un estado</option>
                            <option value="pendiente">Pendiente</option>
                            <option value="completada">Completada</option>
                            <option value="cancelada">Cancelada</option>
                        </select>
                    </div>
                    <div class="campo">
                        <label>Diagnóstico</label>
                        <textarea asp-for="Cita.Diagnostico" rows="2" placeholder="Opcional..."></textarea>
                        <span asp-validation-for="Cita.Diagnostico" class="texto-error"></span>
                    </div>
                    <button type="submit" class="boton-guardar">Guardar Cita</button>
                </form>
            </div>
        </div>

        <!-- Tabla de citas -->
        <div class="col-md-8">
            <div class="panel-filtros mb-3">
                <div class="row g-2 align-items-end">
                    <div class="col-md-4">
                        <label class="etiqueta-campo">Buscar</label>
                        <input type="text" class="campo-texto" placeholder="Mascota o propietario..." required />
                    </div>
                    <div class="col-md-3">
                        <label class="etiqueta-campo">Fecha</label>
                        <input type="date" class="campo-texto" required />
                    </div>
                    <div class="col-md-3">
                        <label class="etiqueta-campo">Estado</label>
                        <select class="campo-texto" required>
                            <option value="">Todos</option>
                            <option value="pendiente">Pendiente</option>
                            <option value="completada">Completada</option>
                            <option value="cancelada">Cancelada</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button class="boton-cafe w-100">Filtrar</button>
                    </div>
                </div>
            </div>

            <div class="panel-tabla">
                <div class="panel-tabla__encabezado">
                    <span class="panel-tabla__titulo">Lista de Citas</span>
                </div>
                <div class="table-responsive">
                    <table class="tabla-citas">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Mascota</th>
                                <th>Propietario</th>
                                <th>Veterinario</th>
                                <th>Fecha</th>
                                <th>Hora</th>
                                <th>Motivo</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cita in Model.ListaCitas)
                            {
                                var mascota = Model.ListaMascotas.FirstOrDefault(m => m.Id == cita.MascotaId);
                                var propietario = Model.ListaPropietarios.FirstOrDefault(p => p.Id == mascota!.PropietarioId);
                                var veterinario = Model.ListaVeterinarios.FirstOrDefault(v => v.Id == cita.VeterinarioId);
                                <tr>
                                    <td>@cita.Id</td>
                                    <td>@(mascota != null ? mascota.Nombre : "-")</td>
                                    <td>@(propietario != null ? propietario.Nombre + " " + propietario.Apellidos : "-")</td>
                                    <td>@(veterinario != null ? veterinario.Nombre + " " + veterinario.Apellidos : "-")</td>
                                    <td>@cita.Fecha.ToString("dd/MM/yyyy")</td>
                                    <td>@cita.Hora</td>
                                    <td>@cita.Motivo</td>
                                    <td>
                                        <span class="estado-cita estado-@cita.EstadoCita.ToLower()">
                                            @cita.EstadoCita
                                        </span>
                                    </td>
                                    <td>
                                        <div class="acciones-tabla">
                                            <button class="boton-accion boton-accion--editar">Editar</button>
                                            <button class="boton-accion boton-accion--cancelar">Cancelar</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</div>
