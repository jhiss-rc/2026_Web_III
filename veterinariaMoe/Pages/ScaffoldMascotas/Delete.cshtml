@page
@model veterinariaMoe.Pages_ScaffoldMascotas.DeleteModel
@{
    ViewData["Title"] = "Eliminar Mascota";
}

<div class="encabezado-pagina">
    <div class="container">
        <h1 class="titulo-pagina">Eliminar Mascota</h1>
    </div>
</div>

<div class="container seccion-contenido">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="registro-contenedor">
                <h5 class="titulo-panel">¿Seguro que deseas eliminar esta mascota?</h5>
                <div class="campo">
                    <label>Nombre</label>
                    <input value="@Model.Mascota.Nombre" class="campo-texto" disabled />
                </div>
                <div class="campo">
                    <label>Especie</label>
                    <input value="@Model.Mascota.Especie" class="campo-texto" disabled />
                </div>
                <div class="campo">
                    <label>Raza</label>
                    <input value="@Model.Mascota.Raza" class="campo-texto" disabled />
                </div>
                <form method="post">
                    <input type="hidden" asp-for="Mascota.Id" />
                    <button type="submit" class="boton-guardar" style="background-color:#B71C1C;">Confirmar Eliminación</button>
                    <a asp-page="./Index" class="boton-cafe-borde d-block text-center mt-2">Cancelar</a>
                </form>
            </div>
        </div>
    </div>
</div>
