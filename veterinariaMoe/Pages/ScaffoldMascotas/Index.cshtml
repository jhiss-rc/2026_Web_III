@page
@model veterinariaMoe.Pages_ScaffoldMascotas.IndexModel
@{
    ViewData["Title"] = "Mascotas";
}

<div class="encabezado-pagina">
    <div class="container">
        <h1 class="titulo-pagina">Mascotas</h1>
    </div>
</div>

<div class="container seccion-contenido">
    <div class="mb-3">
        <a asp-page="Create" class="boton-cafe">+ Nueva Mascota</a>
    </div>
    <div class="panel-tabla">
        <div class="panel-tabla__encabezado">
            <span class="panel-tabla__titulo">Lista de Mascotas</span>
        </div>
        <div class="table-responsive">
            <table class="tabla-citas">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Nombre</th>
                        <th>Propietario</th>
                        <th>Especie</th>
                        <th>Raza</th>
                        <th>Fecha Nac.</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Mascota)
                    {
                        var propietario = Model.ListaPropietarios.FirstOrDefault(p => p.Id == item.PropietarioId);
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.Nombre</td>
                            <td>@(propietario != null ? propietario.Nombre + " " + propietario.Apellidos : "-")</td>
                            <td>@item.Especie</td>
                            <td>@item.Raza</td>
                            <td>@item.FechaNacimiento.ToString("dd/MM/yyyy")</td>
                            <td>
                                <span class="estado-cita @(item.Estado ? "estado-completada" : "estado-cancelada")">
                                    @(item.Estado ? "Activo" : "Inactivo")
                                </span>
                            </td>
                            <td>
                                <div class="acciones-tabla">
                                    <a asp-page="./Edit" asp-route-id="@item.Id" class="boton-accion boton-accion--editar">Editar</a>
                                    <a asp-page="./Details" asp-route-id="@item.Id" class="boton-accion boton-accion--ver">Ver</a>
                                    <a asp-page="./Delete" asp-route-id="@item.Id" class="boton-accion boton-accion--cancelar">Eliminar</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
