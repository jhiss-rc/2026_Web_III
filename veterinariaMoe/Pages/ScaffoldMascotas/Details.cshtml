@page
@model veterinariaMoe.Pages_ScaffoldMascotas.DetailsModel
@{
    ViewData["Title"] = "Detalle Mascota";
}

<div class="encabezado-pagina">
    <div class="container">
        <h1 class="titulo-pagina">Detalle de la Mascota</h1>
    </div>
</div>

<div class="container seccion-contenido">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="registro-contenedor">
                <h5 class="titulo-panel">Información</h5>
                <div class="campo">
                    <label>Nombre</label>
                    <input value="@Model.Mascota.Nombre" class="campo-texto" disabled />
                </div>
                <div class="campo">
                    <label>Propietario</label>
                    <input value="@(Model.Propietario != null ? Model.Propietario.Nombre + " " + Model.Propietario.Apellidos : "-")" class="campo-texto" disabled />
                </div>
                <div class="campo">
                    <label>Especie</label>
                    <input value="@Model.Mascota.Especie" class="campo-texto" disabled />
                </div>
                <div class="campo">
                    <label>Raza</label>
                    <input value="@Model.Mascota.Raza" class="campo-texto" disabled />
                </div>
                <div class="campo">
                    <label>Fecha de Nacimiento</label>
                    <input value="@Model.Mascota.FechaNacimiento.ToString("dd/MM/yyyy")" class="campo-texto" disabled />
                </div>
                <div class="campo">
                    <label>Estado</label>
                    <input value="@(Model.Mascota.Estado ? "Activo" : "Inactivo")" class="campo-texto" disabled />
                </div>
                <div class="d-flex gap-2 mt-2">
                    <a asp-page="./Edit" asp-route-id="@Model.Mascota.Id" class="boton-cafe">Editar</a>
                    <a asp-page="./Index" class="boton-cafe-borde">Volver</a>
                </div>
            </div>
        </div>
    </div>
</div>
