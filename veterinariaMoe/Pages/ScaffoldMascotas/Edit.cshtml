@page
@model veterinariaMoe.Pages_ScaffoldMascotas.EditModel
@{
    ViewData["Title"] = "Editar Mascota";
}

<div class="encabezado-pagina">
    <div class="container">
        <h1 class="titulo-pagina">Editar Mascota</h1>
    </div>
</div>

<div class="container seccion-contenido">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="registro-contenedor">
                <h5 class="titulo-panel">Editar Datos</h5>
                <form method="post">
                    <input type="hidden" asp-for="Mascota.Id" />
                    <div class="campo">
                        <label>Propietario</label>
                        <select asp-for="Mascota.PropietarioId">
                            <option value="">Selecciona un propietario</option>
                            @foreach (var p in Model.ListaPropietarios)
                            {
                                <option value="@p.Id">@p.Nombre @p.Apellidos</option>
                            }
                        </select>
                        <span asp-validation-for="Mascota.PropietarioId" class="texto-error"></span>
                    </div>
                    <div class="campo">
                        <label>Nombre</label>
                        <input asp-for="Mascota.Nombre" />
                        <span asp-validation-for="Mascota.Nombre" class="texto-error"></span>
                    </div>
                    <div class="campo">
                        <label>Especie</label>
                        <input asp-for="Mascota.Especie" />
                        <span asp-validation-for="Mascota.Especie" class="texto-error"></span>
                    </div>
                    <div class="campo">
                        <label>Raza</label>
                        <input asp-for="Mascota.Raza" />
                        <span asp-validation-for="Mascota.Raza" class="texto-error"></span>
                    </div>
                    <div class="campo">
                        <label>Fecha de Nacimiento</label>
                        <input asp-for="Mascota.FechaNacimiento" type="date" />
                        <span asp-validation-for="Mascota.FechaNacimiento" class="texto-error"></span>
                    </div>
                    <div class="campo">
                        <label>Estado</label>
                        <select asp-for="Mascota.Estado">
                            <option value="true">Activo</option>
                            <option value="false">Inactivo</option>
                        </select>
                    </div>
                    <button type="submit" class="boton-guardar">Guardar Cambios</button>
                    <a asp-page="./Index" class="boton-cafe-borde d-block text-center mt-2">Volver</a>
                </form>
            </div>
        </div>
    </div>
</div>
