@page
@model veterinariaMoe.Pages_ScaffoldPropietarios.CreateModel
@{
    ViewData["Title"] = "Nuevo Propietario";
}

<div class="encabezado-pagina">
    <div class="container">
        <h1 class="titulo-pagina">Nuevo Propietario</h1>
    </div>
</div>

<div class="container seccion-contenido">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="registro-contenedor">
                <h5 class="titulo-panel">Datos del Propietario</h5>
                <form method="post">
                    <div class="campo">
                        <label>Nombre</label>
                        <input asp-for="Propietario.Nombre" placeholder="Ej: Juan" />
                        <span asp-validation-for="Propietario.Nombre" class="texto-error"></span>
                    </div>
                    <div class="campo">
                        <label>Apellidos</label>
                        <input asp-for="Propietario.Apellidos" placeholder="Ej: Pérez" />
                        <span asp-validation-for="Propietario.Apellidos" class="texto-error"></span>
                    </div>
                    <div class="campo">
                        <label>Teléfono</label>
                        <input asp-for="Propietario.Telefono" placeholder="Ej: 555-1234" />
                        <span asp-validation-for="Propietario.Telefono" class="texto-error"></span>
                    </div>
                    <div class="campo">
                        <label>Email</label>
                        <input asp-for="Propietario.Email" type="email" placeholder="Ej: juan@correo.com" />
                        <span asp-validation-for="Propietario.Email" class="texto-error"></span>
                    </div>
                    <div class="campo">
                        <label>Estado</label>
                        <select asp-for="Propietario.Estado">
                            <option value="true">Activo</option>
                            <option value="false">Inactivo</option>
                        </select>
                    </div>
                    <button type="submit" class="boton-guardar">Guardar</button>
                    <a asp-page="./Index" class="boton-cafe-borde d-block text-center mt-2">Volver</a>
                </form>
            </div>
        </div>
    </div>
</div>
