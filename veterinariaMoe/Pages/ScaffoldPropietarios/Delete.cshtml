@page
@model veterinariaMoe.Pages_ScaffoldPropietarios.DeleteModel
@{
    ViewData["Title"] = "Eliminar Propietario";
}

<div class="encabezado-pagina">
    <div class="container">
        <h1 class="titulo-pagina">Eliminar Propietario</h1>
    </div>
</div>

<div class="container seccion-contenido">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="registro-contenedor">
                <h5 class="titulo-panel">¿Seguro que deseas eliminar este propietario?</h5>
                <div class="campo">
                    <label>Nombre</label>
                    <input value="@Model.Propietario.Nombre" class="campo-texto" disabled />
                </div>
                <div class="campo">
                    <label>Apellidos</label>
                    <input value="@Model.Propietario.Apellidos" class="campo-texto" disabled />
                </div>
                <div class="campo">
                    <label>Teléfono</label>
                    <input value="@Model.Propietario.Telefono" class="campo-texto" disabled />
                </div>
                <div class="campo">
                    <label>Email</label>
                    <input value="@Model.Propietario.Email" class="campo-texto" disabled />
                </div>
                <form method="post">
                    <input type="hidden" asp-for="Propietario.Id" />
                    <button type="submit" class="boton-guardar" style="background-color:#B71C1C;">Confirmar Eliminación</button>
                    <a asp-page="./Index" class="boton-cafe-borde d-block text-center mt-2">Cancelar</a>
                </form>
            </div>
        </div>
    </div>
</div>
