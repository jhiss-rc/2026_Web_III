@page
@model veterinariaMoe.Pages_ScaffoldCitas.CreateModel
@{
    ViewData["Title"] = "Nueva Cita";
}

<div class="encabezado-pagina">
    <div class="container">
        <h1 class="titulo-pagina">Nueva Cita</h1>
    </div>
</div>

<div class="container seccion-contenido">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="registro-contenedor">
                <h5 class="titulo-panel">Datos de la Cita</h5>
                <form method="post">
                    <div class="campo">
                        <label>Mascota</label>
                        <select asp-for="Cita.MascotaId">
                            <option value="">Selecciona una mascota</option>
                            @foreach (var m in Model.ListaMascotas)
                            {
                                <option value="@m.Id">@m.Nombre (@m.Especie)</option>
                            }
                        </select>
                        <span asp-validation-for="Cita.MascotaId" class="texto-error"></span>
                    </div>
                    <div class="campo">
                        <label>Veterinario</label>
                        <select asp-for="Cita.VeterinarioId">
                            <option value="">Selecciona un veterinario</option>
                            @foreach (var v in Model.ListaVeterinarios)
                            {
                                <option value="@v.Id">@v.Nombre @v.Apellidos</option>
                            }
                        </select>
                        <span asp-validation-for="Cita.VeterinarioId" class="texto-error"></span>
                    </div>
                    <div class="campo">
                        <label>Fecha</label>
                        <input asp-for="Cita.Fecha" type="date" />
                        <span asp-validation-for="Cita.Fecha" class="texto-error"></span>
                    </div>
                    <div class="campo">
                        <label>Hora</label>
                        <input asp-for="Cita.Hora" type="time" />
                        <span asp-validation-for="Cita.Hora" class="texto-error"></span>
                    </div>
                    <div class="campo">
                        <label>Motivo</label>
                        <input asp-for="Cita.Motivo" placeholder="Ej: Revisión general" />
                        <span asp-validation-for="Cita.Motivo" class="texto-error"></span>
                    </div>
                    <div class="campo">
                        <label>Estado</label>
                        <select asp-for="Cita.EstadoCita">
                            <option value="pendiente">Pendiente</option>
                            <option value="completada">Completada</option>
                            <option value="cancelada">Cancelada</option>
                        </select>
                    </div>
                    <div class="campo">
                        <label>Diagnóstico</label>
                        <textarea asp-for="Cita.Diagnostico" rows="2" placeholder="Opcional..."></textarea>
                        <span asp-validation-for="Cita.Diagnostico" class="texto-error"></span>
                    </div>
                    <button type="submit" class="boton-guardar">Guardar Cita</button>
                    <a asp-page="./Index" class="boton-cafe-borde d-block text-center mt-2">Volver</a>
                </form>
            </div>
        </div>
    </div>
</div>
