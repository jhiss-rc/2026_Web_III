@page
@model veterinariaMoe.Pages_ScaffoldCitas.DetailsModel
@{
    ViewData["Title"] = "Detalle Cita";
}

<div class="encabezado-pagina">
    <div class="container">
        <h1 class="titulo-pagina">Detalle de la Cita</h1>
    </div>
</div>

<div class="container seccion-contenido">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="registro-contenedor">
                <h5 class="titulo-panel">Información</h5>
                <div class="campo">
                    <label>Mascota</label>
                    <input value="@(Model.Mascota != null ? Model.Mascota.Nombre + " (" + Model.Mascota.Especie + ")" : "-")" class="campo-texto" disabled />
                </div>
                <div class="campo">
                    <label>Propietario</label>
                    <input value="@(Model.Propietario != null ? Model.Propietario.Nombre + " " + Model.Propietario.Apellidos : "-")" class="campo-texto" disabled />
                </div>
                <div class="campo">
                    <label>Veterinario</label>
                    <input value="@(Model.Veterinario != null ? Model.Veterinario.Nombre + " " + Model.Veterinario.Apellidos : "-")" class="campo-texto" disabled />
                </div>
                <div class="campo">
                    <label>Fecha</label>
                    <input value="@Model.Cita.Fecha.ToString("dd/MM/yyyy")" class="campo-texto" disabled />
                </div>
                <div class="campo">
                    <label>Hora</label>
                    <input value="@Model.Cita.Hora" class="campo-texto" disabled />
                </div>
                <div class="campo">
                    <label>Motivo</label>
                    <input value="@Model.Cita.Motivo" class="campo-texto" disabled />
                </div>
                <div class="campo">
                    <label>Estado</label>
                    <input value="@Model.Cita.EstadoCita" class="campo-texto" disabled />
                </div>
                <div class="campo">
                    <label>Diagnóstico</label>
                    <input value="@Model.Cita.Diagnostico" class="campo-texto" disabled />
                </div>
                <div class="d-flex gap-2 mt-2">
                    <a asp-page="./Edit" asp-route-id="@Model.Cita.Id" class="boton-cafe">Editar</a>
                    <a asp-page="./Index" class="boton-cafe-borde">Volver</a>
                </div>
            </div>
        </div>
    </div>
</div>
