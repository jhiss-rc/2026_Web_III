@page
@model veterinariaMoe.Pages_ScaffoldCitas.DeleteModel
@{
    ViewData["Title"] = "Eliminar Cita";
}

<div class="encabezado-pagina">
    <div class="container">
        <h1 class="titulo-pagina">Eliminar Cita</h1>
    </div>
</div>

<div class="container seccion-contenido">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="registro-contenedor">
                <h5 class="titulo-panel">¿Seguro que deseas eliminar esta cita?</h5>
                <div class="campo">
                    <label>Motivo</label>
                    <input value="@Model.Cita.Motivo" class="campo-texto" disabled />
                </div>
                <div class="campo">
                    <label>Fecha</label>
                    <input value="@Model.Cita.Fecha.ToString("dd/MM/yyyy")" class="campo-texto" disabled />
                </div>
                <div class="campo">
                    <label>Estado</label>
                    <input value="@Model.Cita.EstadoCita" class="campo-texto" disabled />
                </div>
                <form method="post">
                    <input type="hidden" asp-for="Cita.Id" />
                    <button type="submit" class="boton-guardar" style="background-color:#B71C1C;">Confirmar Eliminación</button>
                    <a asp-page="./Index" class="boton-cafe-borde d-block text-center mt-2">Cancelar</a>
                </form>
            </div>
        </div>
    </div>
</div>
