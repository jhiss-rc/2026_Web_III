@page
@model veterinariaMoe.Pages_ScaffoldCitas.IndexModel
@{
    ViewData["Title"] = "Citas";
}

<div class="encabezado-pagina">
    <div class="container">
        <h1 class="titulo-pagina">Gestión de Citas</h1>
    </div>
</div>

<div class="container seccion-contenido">
    <div class="mb-3">
        <a asp-page="Create" class="boton-cafe">+ Nueva Cita</a>
    </div>
    <div class="panel-tabla">
        <div class="panel-tabla__encabezado">
            <span class="panel-tabla__titulo">Lista de Citas</span>
        </div>
        <div class="table-responsive">
            <table class="tabla-citas">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Mascota</th>
                        <th>Propietario</th>
                        <th>Veterinario</th>
                        <th>Fecha</th>
                        <th>Hora</th>
                        <th>Motivo</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Cita)
                    {
                        var mascota = Model.ListaMascotas.FirstOrDefault(m => m.Id == item.MascotaId);
                        var propietario = mascota != null ? Model.ListaPropietarios.FirstOrDefault(p => p.Id == mascota.PropietarioId) : null;
                        var veterinario = Model.ListaVeterinarios.FirstOrDefault(v => v.Id == item.VeterinarioId);
                        <tr>
                            <td>@item.Id</td>
                            <td>@(mascota != null ? mascota.Nombre : "-")</td>
                            <td>@(propietario != null ? propietario.Nombre + " " + propietario.Apellidos : "-")</td>
                            <td>@(veterinario != null ? veterinario.Nombre + " " + veterinario.Apellidos : "-")</td>
                            <td>@item.Fecha.ToString("dd/MM/yyyy")</td>
                            <td>@item.Hora</td>
                            <td>@item.Motivo</td>
                            <td>
                                <span class="estado-cita estado-@item.EstadoCita.ToLower()">
                                    @item.EstadoCita
                                </span>
                            </td>
                            <td>
                                <div class="acciones-tabla">
                                    <a asp-page="./Edit" asp-route-id="@item.Id" class="boton-accion boton-accion--editar">Editar</a>
                                    <a asp-page="./Details" asp-route-id="@item.Id" class="boton-accion boton-accion--ver">Ver</a>
                                    <a asp-page="./Delete" asp-route-id="@item.Id" class="boton-accion boton-accion--cancelar">Eliminar</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
