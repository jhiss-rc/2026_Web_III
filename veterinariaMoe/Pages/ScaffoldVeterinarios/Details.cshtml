@page
@model veterinariaMoe.Pages_ScaffoldVeterinarios.DetailsModel
@{
    ViewData["Title"] = "Detalle Veterinario";
}

<div class="encabezado-pagina">
    <div class="container">
        <h1 class="titulo-pagina">Detalle del Veterinario</h1>
    </div>
</div>

<div class="container seccion-contenido">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="registro-contenedor">
                <h5 class="titulo-panel">Información</h5>
                <div class="campo">
                    <label>Nombre</label>
                    <input value="@Model.Veterinario.Nombre" class="campo-texto" disabled />
                </div>
                <div class="campo">
                    <label>Apellidos</label>
                    <input value="@Model.Veterinario.Apellidos" class="campo-texto" disabled />
                </div>
                <div class="campo">
                    <label>Especialidad</label>
                    <input value="@Model.Veterinario.Especialidad" class="campo-texto" disabled />
                </div>
                <div class="campo">
                    <label>Teléfono</label>
                    <input value="@Model.Veterinario.Telefono" class="campo-texto" disabled />
                </div>
                <div class="campo">
                    <label>Estado</label>
                    <input value="@(Model.Veterinario.Estado ? "Activo" : "Inactivo")" class="campo-texto" disabled />
                </div>
                <div class="d-flex gap-2 mt-2">
                    <a asp-page="./Edit" asp-route-id="@Model.Veterinario.Id" class="boton-cafe">Editar</a>
                    <a asp-page="./Index" class="boton-cafe-borde">Volver</a>
                </div>
            </div>
        </div>
    </div>
</div>
