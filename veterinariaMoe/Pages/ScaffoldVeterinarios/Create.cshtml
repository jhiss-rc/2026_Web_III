@page
@model veterinariaMoe.Pages_ScaffoldVeterinarios.CreateModel
@{
    ViewData["Title"] = "Nuevo Veterinario";
}

<div class="encabezado-pagina">
    <div class="container">
        <h1 class="titulo-pagina">Nuevo Veterinario</h1>
    </div>
</div>

<div class="container seccion-contenido">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="registro-contenedor">
                <h5 class="titulo-panel">Datos del Veterinario</h5>
                <form method="post">
                    <div class="campo">
                        <label>Nombre</label>
                        <input asp-for="Veterinario.Nombre" placeholder="Ej: Juan" />
                        <span asp-validation-for="Veterinario.Nombre" class="texto-error"></span>
                    </div>
                    <div class="campo">
                        <label>Apellidos</label>
                        <input asp-for="Veterinario.Apellidos" placeholder="Ej: García" />
                        <span asp-validation-for="Veterinario.Apellidos" class="texto-error"></span>
                    </div>
                    <div class="campo">
                        <label>Especialidad</label>
                        <input asp-for="Veterinario.Especialidad" placeholder="Ej: Cirugía" />
                        <span asp-validation-for="Veterinario.Especialidad" class="texto-error"></span>
                    </div>
                    <div class="campo">
                        <label>Teléfono</label>
                        <input asp-for="Veterinario.Telefono" placeholder="Ej: 555-1234" />
                        <span asp-validation-for="Veterinario.Telefono" class="texto-error"></span>
                    </div>
                    <div class="campo">
                        <label>Estado</label>
                        <select asp-for="Veterinario.Estado">
                            <option value="true">Activo</option>
                            <option value="false">Inactivo</option>
                        </select>
                    </div>
                    <button type="submit" class="boton-guardar">Guardar</button>
                    <a asp-page="./Index" class="boton-cafe-borde d-block text-center mt-2">Volver</a>
                </form>
            </div>
        </div>
    </div>
</div>
