@page
@model veterinariaMoe.Pages_ScaffoldVeterinarios.IndexModel
@{
    ViewData["Title"] = "Veterinarios";
}

<div class="encabezado-pagina">
    <div class="container">
        <h1 class="titulo-pagina">Veterinarios</h1>
    </div>
</div>

<div class="container seccion-contenido">
    <div class="mb-3">
        <a asp-page="Create" class="boton-cafe">+ Nuevo Veterinario</a>
    </div>
    <div class="panel-tabla">
        <div class="panel-tabla__encabezado">
            <span class="panel-tabla__titulo">Lista de Veterinarios</span>
        </div>
        <div class="table-responsive">
            <table class="tabla-citas">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Nombre</th>
                        <th>Apellidos</th>
                        <th>Especialidad</th>
                        <th>Teléfono</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Veterinario)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.Nombre</td>
                            <td>@item.Apellidos</td>
                            <td>@item.Especialidad</td>
                            <td>@item.Telefono</td>
                            <td>
                                <span class="estado-cita @(item.Estado ? "estado-completada" : "estado-cancelada")">
                                    @(item.Estado ? "Activo" : "Inactivo")
                                </span>
                            </td>
                            <td>
                                <div class="acciones-tabla">
                                    <a asp-page="./Edit" asp-route-id="@item.Id" class="boton-accion boton-accion--editar">Editar</a>
                                    <a asp-page="./Details" asp-route-id="@item.Id" class="boton-accion boton-accion--ver">Ver</a>
                                    <a asp-page="./Delete" asp-route-id="@item.Id" class="boton-accion boton-accion--cancelar">Eliminar</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
