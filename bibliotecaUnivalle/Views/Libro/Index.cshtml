@model IEnumerable<bibliotecaUnivalle.Models.Libro>
@{
    ViewData["Title"] = "Libros";
}

<div class="encabezado-pagina">
    <div class="container">
        <h1 class="titulo-pagina">Libros</h1>
    </div>
</div>

<div class="container seccion-contenido">
    <div class="mb-3">
        <a asp-action="Create" class="boton-cafe">+ Nuevo Libro</a>
    </div>
    <div class="panel-tabla">
        <div class="panel-tabla__encabezado">
            <span class="panel-tabla__titulo">Catálogo de Libros</span>
        </div>
        <div class="table-responsive">
            <table class="tabla-citas">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Título</th>
                        <th>Autor</th>
                        <th>ISBN</th>
                        <th>Catálogo</th>
                        <th>Año</th>
                        <th>Disponibles</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.Titulo</td>
                            <td>@item.Autor</td>
                            <td>@item.ISBN</td>
                            <td>@item.Catalogo</td>
                            <td>@item.AnioPublicacion</td>
                            <td>@item.CantidadDisponible</td>
                            <td>
                                <span class="estado-cita @(item.Estado ? "estado-completada" : "estado-cancelada")">
                                    @(item.Estado ? "Activo" : "Inactivo")
                                </span>
                            </td>
                            <td>
                                <div class="acciones-tabla">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="boton-accion boton-accion--editar">Editar</a>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="boton-accion boton-accion--ver">Ver</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="boton-accion boton-accion--cancelar">Eliminar</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
